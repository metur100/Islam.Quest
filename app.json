{
  "expo": {
    "name": "Islam Quest",
    "slug": "islam-quest",
    "version": "1.0.0",
    "scheme": "islamquest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#14173A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.certidevelopment.islamquest",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.certidevelopment.islamquest",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#14173A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F2B544"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#14173A"
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "./plugins/withStableAndroidBuild",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8db78c71-8002-448a-b93e-ecd87d229910"
      }
    },
    "owner": "certi-development"
  }
}
